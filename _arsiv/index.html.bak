            <button type="button" class="modal-close-btn" onclick="closeModal('cerezModal')">&times;</button>
            <h2>Gizlilik ve Çerez (Cookie) Politikası</h2>
            <div class="modal-content-body">
                <p>Mavi Tik Medya Ajansı olarak web sitemizi ziyaret eden kullanıcılarımızın deneyimini iyileştirmek, site trafiğini analiz etmek ve hizmet kalitemizi artırmak amacıyla çerezler (cookies) kullanmaktayız.</p>
                <p><strong>Çerez Nedir?</strong><br>Çerezler, ziyaret ettiğiniz internet siteleri tarafından tarayıcılar aracılığıyla cihazınıza veya ağ sunucusuna depolanan küçük metin dosyalarıdır.</p>
                <p><strong>Kullanılan Çerez Türleri:</strong></p>
                <ul>
                    <li><strong>Zorunlu Çerezler:</strong> Web sitemizin doğru bir şekilde çalışması için gerekli olan çerezlerdir.</li>
                    <li><strong>Analitik Çerezler:</strong> Ziyaretçi sayıları ve sayfa trafiğini analiz ederek performansımızı ölçmemizi sağlayan çerezlerdir.</li>
                </ul>
                <p>Tarayıcı ayarlarınızı değiştirerek çerezlere ilişkin tercihlerinizi kişiselleştirme veya çerezleri engelleme hakkına sahipsiniz.</p>
            </div>
        </div>
    </div>

    <!-- 3. Kullanım Koşulları Modal -->
    <div id="kullanimModal" class="modal-overlay" onclick="handleModalOverlayClick(event, 'kullanimModal')">
        <div class="modal-box">
            <button type="button" class="modal-close-btn" onclick="closeModal('kullanimModal')">&times;</button>
            <h2>Kullanım Koşulları</h2>
            <div class="modal-content-body">
                <p>Bu web sitesini ziyaret ederek ve kullanarak aşağıdaki kullanım şartlarını kabul etmiş sayılırsınız:</p>
                <ul>
                    <li><strong>Fikri Mülkiyet:</strong> Bu sitede yer alan tüm metinler, görseller, logolar ve tasarımlar Mavi Tik Medya Ajansı’na aittir. İzin alınmadan kopyalanamaz veya çoğaltılamaz.</li>
                    <li><strong>Hizmet Değişiklikleri:</strong> Mavi Tik Medya Ajansı, sitede sunulan bilgileri, hizmet detaylarını ve şartları önceden haber vermeksizin değiştirme hakkını saklı tutar.</li>
                    <li><strong>Sorumluluk Sınırı:</strong> Sitede yer alan bilgilerin güncelliği ve doğruluğu için azami çaba gösterilmektedir; ancak doğrudan/dolaylı doğabilecek aksaklıklardan ajansımız sorumlu tutulamaz.</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- ================================================================
         JAVASCRIPT LOGIC
         ================================================================ -->
    <script>
        // 1. Navbar Scroll Effect & Active Highlight
        const navbar = document.getElementById('navbar');
        const scrollTopBtn = document.getElementById('scrollTopBtn');

        window.addEventListener('scroll', () => {
            const scrollPos = window.scrollY;
            
            // Navbar shrink & glass effect
            if (scrollPos > 30) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }

            // Scroll Top Button visibility
            if (scrollPos > 350) {
                scrollTopBtn.classList.add('visible');
            } else {
                scrollTopBtn.classList.remove('visible');
            }
        });

        function scrollToTop() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        }

        // 2. Mobile Drawer Navigation
        const hamburgerBtn = document.getElementById('hamburgerBtn');
        const mobileDrawer = document.getElementById('mobileDrawer');
        const mobileLinks = document.querySelectorAll('.mob-link');

        function toggleMobileMenu() {
            hamburgerBtn.classList.toggle('active');
            mobileDrawer.classList.toggle('open');
            document.body.style.overflow = mobileDrawer.classList.contains('open') ? 'hidden' : '';
        }

        hamburgerBtn.addEventListener('click', toggleMobileMenu);

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                hamburgerBtn.classList.remove('active');
                mobileDrawer.classList.remove('open');
                document.body.style.overflow = '';
            });
        });

        // 3. FAQ Accordion Logic
        function toggleFaq(btn) {
            const card = btn.closest('.faq-item-card');
            const isOpen = card.classList.contains('open');

            // Close all
            document.querySelectorAll('.faq-item-card').forEach(c => c.classList.remove('open'));

            // Toggle clicked card
            if (!isOpen) {
                card.classList.add('open');
            }
        }

        // 4. Modal Open & Close Logic
        function openModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.remove('active');
                document.body.style.overflow = '';
            }
        }

        function handleModalOverlayClick(e, modalId) {
            if (e.target.classList.contains('modal-overlay')) {
                closeModal(modalId);
            }
        }

        // Escape key closes modals
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal-overlay.active').forEach(m => {
                    m.classList.remove('active');
                });
                document.body.style.overflow = '';
            }
        });

        // 5. Send via WhatsApp Generator
        function sendViaWhatsApp() {
            const name = document.getElementById('formName').value.trim();
            const phone = document.getElementById('formPhone').value.trim();
            const email = document.getElementById('formEmail').value.trim() || 'Belirtilmedi';
            const service = document.getElementById('formService').value || 'Genel Danışma';
            const subject = document.getElementById('formSubject').value.trim() || 'Yeni Proje Talebi';
            const message = document.getElementById('formMessage').value.trim() || 'Detaylar görüşülecektir.';

            if (!name || !phone) {
                alert('Lütfen en azından Ad Soyad ve Telefon bilginizi doldurunuz.');
                return;
            }

            const waText = 
                `Merhaba Mavi Tik Medya Ajansı! Web siteniz üzerinden teklif almak istiyorum:\n\n` +
                `👤 *Ad Soyad:* ${name}\n` +
                `📞 *Telefon:* ${phone}\n` +
                `✉️ *E-posta:* ${email}\n` +
                `🎯 *Hizmet:* ${service}\n` +
                `📌 *Konu:* ${subject}\n` +
                `📝 *Mesaj:* ${message}`;

            const waUrl = `https://wa.me/905533650396?text=${encodeURIComponent(waText)}`;
            window.open(waUrl, '_blank');
        }

        // 6. Direct Mail Generator (Fallback)
        function sendViaMailto() {
            const name = document.getElementById('formName').value.trim() || 'İsimsiz Müşteri';
            const phone = document.getElementById('formPhone').value.trim() || 'Belirtilmedi';
            const email = document.getElementById('formEmail').value.trim() || 'Belirtilmedi';
            const service = document.getElementById('formService').value || 'Genel Ajans Hizmeti';
            const subject = document.getElementById('formSubject').value.trim() || `Teklif Talebi - ${name}`;
            const message = document.getElementById('formMessage').value.trim() || 'Merhaba, hizmetleriniz hakkında bilgi ve teklif almak istiyorum.';

            const emailSubject = `[Mavi Tik Medya] Teklif Talebi - ${name} (${service})`;
            const emailBody = 
`Merhaba Mavi Tik Medya Ajansı,

Web siteniz üzerinden yeni bir teklif talebi iletiyorum:

👤 Ad Soyad: ${name}
📞 Telefon / WhatsApp: ${phone}
✉️ E-posta: ${email}
🎯 İlgilenilen Hizmet: ${service}
📌 Konu Başlığı: ${subject}

📝 Mesaj:
${message}

İyi çalışmalar dilerim.`;

            const mailtoUrl = `mailto:mavitikmedyaajansi@gmail.com?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`;
            window.location.href = mailtoUrl;
        }

        // 7. FormSubmit Submission Handler (FormSubmit AJAX with Native Fallback)
        const contactForm = document.getElementById('mainContactForm');
        if (contactForm) {
            contactForm.addEventListener('submit', async function(e) {
                e.preventDefault();

                const alertBox = document.getElementById('formAlertBox');
                const submitBtn = document.getElementById('formSubmitBtn');
                const originalBtnText = submitBtn.innerHTML;

                const name = document.getElementById('formName').value.trim();
                const phone = document.getElementById('formPhone').value.trim();
                const email = document.getElementById('formEmail').value.trim();
                const service = document.getElementById('formService').value;
                const subject = document.getElementById('formSubject').value.trim() || `Teklif Talebi - ${name}`;
                const message = document.getElementById('formMessage').value.trim();

                // Validation
                if (!name || !phone || !email || !service || !message) {
                    if (alertBox) {
                        alertBox.innerHTML = `
                            <div class="form-alert error">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <div><strong>Lütfen Eksik Alanları Doldurunuz:</strong><br>Ad Soyad, Telefon, E-posta, Hizmet ve Mesaj alanları zorunludur.</div>
                            </div>`;
                        alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }
                    return;
                }

                // Check if opened as local file (file://)
                if (window.location.protocol === 'file:') {
                    if (alertBox) {
                        alertBox.innerHTML = `
                            <div class="form-alert info">
                                <i class="fa-solid fa-circle-info"></i>
                                <div>
                                    <strong>Yerel Dosyada (file://) E-posta Gönderilemez:</strong><br>
                                    FormSubmit güvenlik kuralları gereği doğrudan çift tıklanarak açılan yerel HTML dosyalarında çalışmaz.<br><br>
                                    <strong>Nasıl Test Edebilirsiniz?</strong><br>
                                    1. Tarayıcınızın adres çubuğuna <a href="http://localhost:3000/#iletisim" target="_blank" style="font-weight: 700; text-decoration: underline; color: #0062FF;">http://localhost:3000</a> yazarak sitenizi açıp formu test edebilirsiniz (yerel web sunucunuz arka planda çalışmaktadır).<br>
                                    2. Siteyi GitHub'a veya canlı sunucuya yüklediğinizde gerçek web adresi (https) üzerinden FormSubmit doğrudan ve eksiksiz çalışacaktır.<br><br>
                                    <button type="button" class="btn btn-whatsapp" style="padding: 8px 16px; font-size: 13.5px;" onclick="sendViaWhatsApp()">
                                        <i class="fa-brands fa-whatsapp"></i> Şimdilik WhatsApp ile Test Et
                                    </button>
                                </div>
                            </div>`;
                        alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }
                    return;
                }

                // Loading State
                submitBtn.disabled = true;
                submitBtn.classList.add('btn-loading');
                submitBtn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin"></i> Gönderiliyor...`;
                if (alertBox) alertBox.innerHTML = '';

                // Try FormSubmit AJAX with 3s timeout guard
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 3000);

                try {
                    const response = await fetch('https://formsubmit.co/ajax/mavitikmedyaajansi@gmail.com', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({
                            name: name,
                            phone: phone,
                            email: email,
                            service: service,
                            subject: subject,
                            message: message,
                            _subject: `Yeni Teklif Talebi: ${name} (${service})`,
                            _captcha: 'false',
                            _template: 'table'
                        }),
                        signal: controller.signal
                    });

                    clearTimeout(timeoutId);
                    const data = await response.json().catch(() => ({}));

                    if (response.ok && (data.success === 'true' || data.success === true)) {
                        // Success in background without page change!
                        if (alertBox) {
                            alertBox.innerHTML = `
                                <div class="form-alert success">
                                    <i class="fa-solid fa-circle-check"></i>
                                    <div>
                                        <strong>Mesajınız Başarıyla İletildi!</strong><br>
                                        Talebiniz FormSubmit üzerinden ekibimize ulaştı. En kısa sürede sizinle iletişime geçeceğiz. Teşekkür ederiz!
                                    </div>
                                </div>`;
                        }
                        contactForm.reset();
                        submitBtn.disabled = false;
                        submitBtn.classList.remove('btn-loading');
                        submitBtn.innerHTML = originalBtnText;
                        alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    } else {
                        // If AJAX returned not-ok, submit natively to FormSubmit
                        contactForm.submit();
                    }
                } catch (err) {
                    clearTimeout(timeoutId);
                    console.log('FormSubmit AJAX fallback triggering native submit...', err);
                    // Native submit to FormSubmit
                    contactForm.submit();
                }
            });
        }

        /* ==============================================================
           APPLE & CYBERPUNK ULTRA-LUXE KEYNOTE INTRO CONTROLLER (60 FPS)
           ============================================================== */
        (function() {
            const appleIntro = document.getElementById('apple-intro');
            if (!appleIntro) return;

            const ambientAurora = document.getElementById('ambientAurora');
            const precisionGrid = document.getElementById('precisionGrid');
            const crystalBeam = document.getElementById('crystalBeam');
            const laserStreamsSvg = document.getElementById('laserStreamsSvg');
            const laserStreamLeft = document.getElementById('laserStreamLeft');
            const laserStreamRight = document.getElementById('laserStreamRight');
            const glassEmblem = document.getElementById('glassEmblem');
            const titleBlock = document.getElementById('titleBlock');
            const appleSkipBtn = document.getElementById('appleSkipBtn');
            const appleProgress = document.getElementById('appleProgress');

            let introTimeouts = [];

            function playAppleIntro() {
                introTimeouts.forEach(t => clearTimeout(t));
                introTimeouts = [];

                appleIntro.style.display = 'flex';
                document.body.style.overflow = 'hidden';
                window.scrollTo({ top: 0, behavior: 'instant' });

                appleIntro.classList.remove('intro-dismissed');
                if (ambientAurora) ambientAurora.classList.remove('ignited');
                if (precisionGrid) precisionGrid.classList.remove('active');
                if (crystalBeam) crystalBeam.classList.remove('active', 'faded');
                if (laserStreamsSvg) laserStreamsSvg.classList.remove('faded');
                if (glassEmblem) glassEmblem.classList.remove('revealed');
                if (titleBlock) titleBlock.classList.remove('revealed');
                
                if (laserStreamLeft) laserStreamLeft.style.strokeDashoffset = '1000';
                if (laserStreamRight) laserStreamRight.style.strokeDashoffset = '1000';
                if (appleProgress) appleProgress.style.width = '0%';

                // 1. İlerleme çubuğu (30ms)
                introTimeouts.push(setTimeout(() => {
                    if (appleProgress) appleProgress.style.width = '100%';
                }, 20));

                // 2. Aurora ve Izgara Deseni (150ms)
                introTimeouts.push(setTimeout(() => {
                    if (ambientAurora) ambientAurora.classList.add('ignited');
                    if (precisionGrid) precisionGrid.classList.add('active');
                }, 80));

                // 3. Lazer Çizgileri ve Kristal Işık Huzmesi (300ms)
                introTimeouts.push(setTimeout(() => {
                    if (laserStreamLeft) laserStreamLeft.style.strokeDashoffset = '0';
                    if (laserStreamRight) laserStreamRight.style.strokeDashoffset = '0';
                    if (crystalBeam) crystalBeam.classList.add('active');
                }, 180));

                // 4. 3D Cam Kaide & Logo Sahneye Çıkar (650ms)
                introTimeouts.push(setTimeout(() => {
                    if (glassEmblem) glassEmblem.classList.add('revealed');
                    if (crystalBeam) crystalBeam.classList.add('faded');
                }, 480));

                // 5. Yan Lazer Çizgileri Yavaşça Kaybolur, Sahne Temizlenir (900ms)
                introTimeouts.push(setTimeout(() => {
                    if (laserStreamsSvg) laserStreamsSvg.classList.add('faded');
                }, 680));

                // 6. Net Tipografi & Slogan Işıkla Açılır (1050ms)
                introTimeouts.push(setTimeout(() => {
                    if (titleBlock) titleBlock.classList.add('revealed');
                }, 780));

                // 7. Sinematik Yumuşak Geçiş (3.3s)
                introTimeouts.push(setTimeout(() => {
                    finishAppleIntro();
                }, 2400));
            }

            function finishAppleIntro() {
                if (appleIntro) appleIntro.classList.add('intro-dismissed');
                introTimeouts.forEach(t => clearTimeout(t));
                document.body.style.overflow = '';

                setTimeout(() => {
                    if (appleIntro && appleIntro.classList.contains('intro-dismissed')) {
                        appleIntro.style.display = 'none';
                    }
                }, 950);
            }

            if (appleSkipBtn) {
                appleSkipBtn.addEventListener('click', finishAppleIntro);
            }

            window.playMaviTikIntro = playAppleIntro;

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', playAppleIntro);
            } else {
                playAppleIntro();
            }
        })();

    </script>
</body>
</html>