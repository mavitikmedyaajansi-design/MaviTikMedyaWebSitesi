<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mavi Tik Medya Ajansı | Dijital Medya & Büyüme Çözümleri</title>
    <meta name="description" content="Mavi Tik Medya Ajansı — Sosyal Medya Yönetimi, Web Tasarım & Geliştirme, Dijital Reklamcılık, Kurumsal Kimlik, Yapay Zeka (AI) Çözümleri ve 360° Görsel Hizmetler ile markanızı zirveye taşıyoruz.">
    <meta name="keywords" content="mavi tik medya, dijital medya ajansı, sosyal medya yönetimi, web tasarım, dijital reklamcılık, yapay zeka çözümleri, 360 sanal tur, kurumsal kimlik, gaziantep medya ajansı">
    <meta name="author" content="Mavi Tik Medya Ajansı">

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Mavi Tik Medya Ajansı | Dijital Dünyada Mavi Tik Etkisi">
    <meta property="og:description" content="Markanızı dijital platformlarda zirveye taşımak, yaratıcı stratejiler ve kusursuz çözümler üretmek için buradayız.">
    <meta property="og:image" content="assets/images/ana.png">
    <meta property="og:url" content="https://mavitikmedya.com/">

    <!-- Favicon -->
    <link rel="icon" href="assets/images/logo.png" type="image/png">

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- FontAwesome 6.4.0 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ================================================================
           DESIGN SYSTEM & VARIABLES
           ================================================================ */
        :root {
            --primary: #0062FF;
            --primary-dark: #004ecc;
            --primary-light: #EBF3FF;
            --primary-glow: rgba(0, 98, 255, 0.18);
            
            --secondary: #00C2FF;
            --secondary-glow: rgba(0, 194, 255, 0.25);
            --accent-emerald: #10B981;
            --accent-amber: #F59E0B;
            
            --dark: #070F26;
            --dark-surface: #0E1A3D;
            --dark-card: #14234E;
            
            --slate-900: #0F172A;
            --slate-800: #1E293B;
            --slate-700: #334155;
            --slate-600: #475569;
            --slate-500: #64748B;
            --slate-400: #94A3B8;
            --slate-200: #E2E8F0;
            --slate-100: #F1F5F9;
            --slate-50:  #F8FAFC;
            --white:     #FFFFFF;

            --font-display: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-body:    'Inter', -apple-system, BlinkMacSystemFont, sans-serif;

            --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 8px 24px -4px rgba(15, 23, 42, 0.08), 0 3px 8px -2px rgba(15, 23, 42, 0.04);
            --shadow-lg: 0 16px 40px -6px rgba(15, 23, 42, 0.12), 0 6px 16px -3px rgba(15, 23, 42, 0.06);
            --shadow-hover: 0 24px 50px -8px rgba(0, 98, 255, 0.22);

            --radius-sm: 10px;
            --radius-md: 16px;
            --radius-lg: 24px;
            --radius-xl: 32px;
            --radius-full: 9999px;

            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* ================================================================
           BASE RESET
           ================================================================ */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 86px;
            -webkit-text-size-adjust: 100%;
            overflow-x: hidden;
            width: 100%;
        }

        body {
            font-family: var(--font-body);
            background-color: var(--white);
            color: var(--slate-700);
            line-height: 1.7;
            font-size: 16px;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-display);
            color: var(--slate-900);
            font-weight: 700;
            line-height: 1.25;
            letter-spacing: -0.02em;
        }

        a {
            color: inherit;
            text-decoration: none;
            transition: var(--transition);
        }

        img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        ul {
            list-style: none;
        }

        button, input, select, textarea {
            font-family: inherit;
            font-size: inherit;
        }

        .container {
            width: 100%;
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* ================================================================
           UTILITY & DECORATIVE CLASSES
           ================================================================ */
        .text-gradient {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .badge-pill {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 7px 18px;
            background: var(--primary-light);
            color: var(--primary);
            border-radius: var(--radius-full);
            font-size: 13.5px;
            font-weight: 700;
            letter-spacing: -0.01em;
            border: 1px solid rgba(0, 98, 255, 0.12);
        }

        .badge-pill .pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--primary);
            position: relative;
        }

        .badge-pill .pulse-dot::after {
            content: '';
            position: absolute;
            inset: -3px;
            border-radius: 50%;
            background: var(--primary);
            opacity: 0.5;
            animation: pulseDot 1.8s infinite;
        }

        @keyframes pulseDot {
            0% { transform: scale(1); opacity: 0.6; }
            50% { transform: scale(2.2); opacity: 0; }
            100% { transform: scale(1); opacity: 0; }
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 14px 28px;
            border-radius: var(--radius-full);
            font-family: var(--font-display);
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid transparent;
            transition: var(--transition);
            white-space: nowrap;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, #0050d4 100%);
            color: var(--white);
            box-shadow: 0 6px 20px rgba(0, 98, 255, 0.35);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(0, 98, 255, 0.45);
            color: var(--white);
        }

        .btn-outline {
            background: var(--white);
            color: var(--slate-900);
            border-color: var(--slate-200);
            box-shadow: var(--shadow-sm);
        }

        .btn-outline:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: var(--primary-light);
            transform: translateY(-2px);
        }

        .btn-whatsapp {
            background: #25D366;
            color: var(--white);
            box-shadow: 0 6px 18px rgba(37, 211, 102, 0.35);
        }

        .btn-whatsapp:hover {
            background: #1eb855;
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(37, 211, 102, 0.45);
            color: var(--white);
        }

        .btn-sm {
            padding: 10px 20px;
            font-size: 14px;
        }

        /* Section Commons */
        .section {
            padding: 100px 0;
            position: relative;
        }

        .section-header {
            text-align: center;
            max-width: 720px;
            margin: 0 auto 60px;
        }

        .section-tag {
            display: inline-block;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.6px;
            color: var(--primary);
            margin-bottom: 12px;
            background: var(--primary-light);
            padding: 4px 14px;
            border-radius: var(--radius-full);
        }

        .section-title {
            font-size: clamp(30px, 4vw, 44px);
            margin-bottom: 16px;
            letter-spacing: -0.025em;
        }

        .section-desc {
            font-size: 17px;
            color: var(--slate-500);
            line-height: 1.65;
        }

        .bg-light {
            background-color: var(--slate-50);
        }

        .bg-dark {
            background-color: var(--dark);
            color: var(--slate-400);
        }

        .bg-dark h1, .bg-dark h2, .bg-dark h3, .bg-dark h4 {
            color: var(--white);
        }

        /* Ambient floating micro-animation for 3D art */
        @keyframes gentleFloat {
            0% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(0.5deg); }
            100% { transform: translateY(0px) rotate(0deg); }
        }

        .float-animate {
            animation: gentleFloat 6s ease-in-out infinite;
        }

        /* ================================================================
           HEADER / NAVBAR
           ================================================================ */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 86px;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            z-index: 1000;
            border-bottom: 1px solid rgba(226, 232, 240, 0.7);
            transition: var(--transition);
        }

        .navbar.scrolled {
            height: 74px;
            background: rgba(255, 255, 255, 0.98);
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
        }

        .nav-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 100%;
        }

        /* Brand Logo */
        .nav-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .nav-brand-logo {
            height: 48px;
            width: auto;
            object-fit: contain;
            transition: var(--transition);
        }

        .navbar.scrolled .nav-brand-logo {
            height: 42px;
        }

        .nav-brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
        }

        .nav-brand-title {
            font-family: var(--font-display);
            font-size: 19px;
            font-weight: 800;
            color: var(--slate-900);
            letter-spacing: -0.02em;
        }

        .nav-brand-title span {
            color: var(--primary);
        }

        .nav-brand-sub {
            font-size: 11px;
            font-weight: 600;
            color: var(--slate-500);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Desktop Nav Menu */
        .nav-menu {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav-item {
            position: relative;
        }

        .nav-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 16px;
            font-size: 15px;
            font-weight: 600;
            color: var(--slate-700);
            border-radius: var(--radius-sm);
            transition: var(--transition);
        }

        .nav-link:hover, .nav-link.active {
            color: var(--primary);
            background: var(--primary-light);
        }

        .nav-link i.fa-chevron-down {
            font-size: 10px;
            transition: transform 0.25s ease;
        }

        .nav-item:hover .nav-link i.fa-chevron-down {
            transform: rotate(180deg);
        }

        /* Dropdown Menus */
        .nav-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            min-width: 260px;
            background: var(--white);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--slate-200);
            padding: 10px;
            opacity: 0;
            visibility: hidden;
            transform: translateY(12px);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 100;
        }

        .nav-item:hover .nav-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(4px);
        }

        .dropdown-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            font-size: 14px;
            font-weight: 600;
            color: var(--slate-700);
            border-radius: var(--radius-sm);
            transition: var(--transition);
        }

        .dropdown-link i {
            font-size: 15px;
            width: 22px;
            color: var(--primary);
            transition: var(--transition);
        }

        .dropdown-link:hover {
            background: var(--primary-light);
            color: var(--primary);
            transform: translateX(4px);
        }

        /* Nav Actions */
        .nav-actions {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .nav-social-icons {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav-social-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--slate-600);
            background: var(--slate-100);
            font-size: 14px;
            transition: var(--transition);
        }

        .nav-social-btn:hover {
            background: var(--primary);
            color: var(--white);
            transform: translateY(-2px);
        }

        .nav-hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 8px;
        }

        .nav-hamburger span {
            width: 24px;
            height: 2.5px;
            background: var(--slate-900);
            border-radius: 2px;
            transition: var(--transition);
        }

        .nav-hamburger.active span:nth-child(1) {
            transform: translateY(7.5px) rotate(45deg);
        }

        .nav-hamburger.active span:nth-child(2) {
            opacity: 0;
            transform: scaleX(0);
        }

        .nav-hamburger.active span:nth-child(3) {
            transform: translateY(-7.5px) rotate(-45deg);
        }

        /* Mobile Drawer */
        .mobile-drawer {
            position: fixed;
            top: 86px;
            left: 0;
            width: 100%;
            height: calc(100vh - 86px);
            background: var(--white);
            padding: 28px 24px;
            overflow-y: auto;
            transform: translateX(-100%);
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 999;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }

        .mobile-drawer.open {
            transform: translateX(0);
        }

        .mobile-nav-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .mobile-nav-item {
            border-bottom: 1px solid var(--slate-100);
            padding-bottom: 6px;
        }

        .mobile-nav-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 0;
            font-size: 16px;
            font-weight: 700;
            color: var(--slate-900);
        }

        .mobile-sub-list {
            padding-left: 16px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin: 6px 0 12px;
        }

        .mobile-sub-link {
            font-size: 14px;
            color: var(--slate-600);
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 0;
        }

        .mobile-sub-link i {
            color: var(--primary);
            width: 16px;
        }

        /* ================================================================
           HERO SECTION
           ================================================================ */
        .hero {
            padding: 150px 0 90px;
            background: radial-gradient(circle at 80% 20%, rgba(0, 194, 255, 0.08) 0%, rgba(255, 255, 255, 0) 60%),
                        radial-gradient(circle at 10% 40%, rgba(0, 98, 255, 0.06) 0%, rgba(255, 255, 255, 0) 50%);
            position: relative;
            overflow: hidden;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            align-items: center;
            gap: 50px;
        }

        .hero-title {
            font-size: clamp(38px, 5vw, 60px);
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -0.03em;
            margin: 20px 0 22px;
        }

        .hero-desc {
            font-size: 19px;
            color: var(--slate-600);
            line-height: 1.65;
            margin-bottom: 34px;
            max-width: 580px;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            margin-bottom: 48px;
        }

        .hero-trust-bar {
            display: grid;
            grid-template-columns: repeat(4, auto);
            gap: 28px;
            padding-top: 30px;
            border-top: 1px solid var(--slate-200);
        }

        .trust-stat-num {
            font-family: var(--font-display);
            font-size: 26px;
            font-weight: 800;
            color: var(--slate-900);
            line-height: 1;
            margin-bottom: 4px;
        }

        .trust-stat-num span {
            color: var(--primary);
        }

        .trust-stat-label {
            font-size: 13px;
            color: var(--slate-500);
            font-weight: 500;
        }

        /* Hero Visual Showcase */
        .hero-visual-wrapper {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hero-visual-glow {
            position: absolute;
            width: 80%;
            height: 80%;
            background: radial-gradient(circle, rgba(0, 98, 255, 0.25) 0%, rgba(0, 194, 255, 0.1) 50%, transparent 70%);
            filter: blur(50px);
            z-index: 1;
        }

        .hero-main-img {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 520px;
            height: auto;
            object-fit: contain;
            filter: drop-shadow(0 20px 40px rgba(0, 98, 255, 0.2));
        }

        /* Floating Badge Cards */
        .hero-float-card {
            position: absolute;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: var(--radius-md);
            padding: 12px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: var(--shadow-lg);
            z-index: 3;
            animation: gentleFloat 5s ease-in-out infinite;
        }

        .hero-float-card.top-right {
            top: 20px;
            right: -10px;
            animation-delay: 1s;
        }

        .hero-float-card.bottom-left {
            bottom: 25px;
            left: -15px;
            animation-delay: 2.5s;
        }

        .hfc-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: var(--white);
        }

        .hfc-icon.blue { background: linear-gradient(135deg, var(--primary), var(--secondary)); }
        .hfc-icon.green { background: linear-gradient(135deg, #10B981, #059669); }

        .hfc-text strong {
            display: block;
            font-size: 14px;
            color: var(--slate-900);
            font-weight: 700;
        }

        .hfc-text span {
            font-size: 12px;
            color: var(--slate-500);
        }

        /* ================================================================
           PARTNERS & PLATFORM MARQUEE
           ================================================================ */
        .partners-bar {
            padding: 24px 0;
            background: var(--slate-50);
            border-top: 1px solid var(--slate-200);
            border-bottom: 1px solid var(--slate-200);
        }

        .partners-wrapper {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
        }

        .partners-title {
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--slate-400);
        }

        .partner-pill-group {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
        }

        .partner-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-full);
            font-size: 13.5px;
            font-weight: 600;
            color: var(--slate-700);
            box-shadow: var(--shadow-sm);
        }

        .partner-pill i {
            color: var(--primary);
            font-size: 15px;
        }

        /* ================================================================
           KURUMSAL 1: HAKKIMIZDA
           ================================================================ */
        .about-split {
            display: grid;
            grid-template-columns: 1fr 1.15fr;
            gap: 60px;
            align-items: center;
            margin-bottom: 60px;
        }

        .about-img-box {
            position: relative;
            display: flex;
            justify-content: center;
        }

        .about-main-img {
            max-width: 480px;
            width: 100%;
            height: auto;
            object-fit: contain;
            filter: drop-shadow(0 15px 35px rgba(0, 98, 255, 0.15));
        }

        .about-text h3 {
            font-size: 32px;
            margin-bottom: 20px;
            line-height: 1.3;
        }

        .about-text p {
            font-size: 17px;
            color: var(--slate-600);
            line-height: 1.75;
            margin-bottom: 16px;
        }

        /* Misyon & Vizyon Grid */
        .info-cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
            margin-bottom: 36px;
        }

        .info-box-card {
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-lg);
            padding: 32px;
            box-shadow: var(--shadow-md);
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

        .info-box-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            opacity: 0;
            transition: var(--transition);
        }

        .info-box-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-hover);
        }

        .info-box-card:hover::before {
            opacity: 1;
        }

        .info-card-icon {
            width: 54px;
            height: 54px;
            border-radius: var(--radius-md);
            background: var(--primary-light);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            margin-bottom: 20px;
        }

        .info-box-card h3 {
            font-size: 22px;
            margin-bottom: 12px;
        }

        .info-box-card p {
            font-size: 15.5px;
            color: var(--slate-600);
            line-height: 1.7;
        }

        /* Hedefimiz & Hayalimiz */
        .goal-cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
        }

        .goal-card {
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-lg);
            padding: 32px;
            box-shadow: var(--shadow-md);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .goal-card h3 {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 22px;
            margin-bottom: 20px;
            color: var(--slate-900);
        }

        .goal-card h3 i {
            color: var(--primary);
        }

        .goal-list {
            margin-bottom: 24px;
        }

        .goal-list li {
            position: relative;
            padding-left: 26px;
            font-size: 15px;
            color: var(--slate-600);
            margin-bottom: 14px;
            line-height: 1.6;
        }

        .goal-list li::before {
            content: '✓';
            position: absolute;
            left: 0;
            top: 0;
            color: var(--primary);
            font-weight: 800;
        }

        .goal-footer-quote {
            padding: 16px;
            background: var(--slate-50);
            border-left: 3px solid var(--primary);
            border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
            font-size: 14px;
            font-style: italic;
            color: var(--slate-700);
            margin-top: auto;
        }

        /* ================================================================
           KURUMSAL 2: HİKAYEMİZ (MAVİ MAKAV PAPAĞANI)
           ================================================================ */
        .story-section {
            background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
        }

        .story-wrapper {
            display: grid;
            grid-template-columns: 1.25fr 1fr;
            gap: 50px;
            align-items: center;
        }

        .story-img-card {
            position: relative;
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 16px;
            border: 1px solid var(--slate-200);
            box-shadow: 0 20px 50px -10px rgba(0, 98, 255, 0.22);
            text-align: center;
            transition: var(--transition);
        }

        .story-img-card:hover {
            box-shadow: 0 25px 60px -10px rgba(0, 98, 255, 0.3);
            transform: translateY(-4px);
        }

        .story-main-img {
            max-width: 100%;
            width: 100%;
            height: auto;
            object-fit: contain;
            display: block;
            margin: 0 auto;
            border-radius: var(--radius-lg);
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
        }

        .story-main-img:hover {
            transform: scale(1.02);
        }

        .story-badge-bottom {
            margin-top: 16px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 14.5px;
            font-weight: 700;
            color: var(--primary);
            background: var(--primary-light);
            padding: 10px 24px;
            border-radius: var(--radius-full);
            cursor: pointer;
            transition: var(--transition);
            border: 1px solid rgba(0, 98, 255, 0.15);
        }

        .story-badge-bottom:hover {
            background: var(--primary);
            color: var(--white);
        }

        .story-content h3 {
            font-size: 28px;
            margin-bottom: 20px;
            color: var(--slate-900);
        }

        .story-content p {
            font-size: 16px;
            color: var(--slate-600);
            line-height: 1.75;
            margin-bottom: 16px;
        }

        .story-content strong {
            color: var(--primary-dark);
            font-weight: 700;
        }

        .story-traits-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
            margin-top: 28px;
        }

        .trait-item {
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-md);
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: var(--shadow-sm);
        }

        .trait-item i {
            font-size: 20px;
            color: var(--primary);
        }

        .trait-item div strong {
            display: block;
            font-size: 14.5px;
            color: var(--slate-900);
        }

        .trait-item div span {
            font-size: 12.5px;
            color: var(--slate-500);
        }

        /* ================================================================
           KURUMSAL 3: NASIL ÇALIŞIYORUZ (WORKFLOW)
           ================================================================ */
        .workflow-banner {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            align-items: center;
            gap: 40px;
            background: linear-gradient(135deg, var(--dark) 0%, #152247 100%);
            border-radius: var(--radius-xl);
            padding: 40px 50px;
            color: var(--white);
            margin-bottom: 60px;
            box-shadow: var(--shadow-lg);
        }

        .workflow-banner-img {
            max-width: 420px;
            width: 100%;
            height: auto;
            object-fit: contain;
            filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.4));
        }

        .workflow-banner-text h3 {
            font-size: 28px;
            color: var(--white);
            margin-bottom: 14px;
        }

        .workflow-banner-text p {
            font-size: 17px;
            color: var(--slate-300);
            line-height: 1.7;
        }

        .steps-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 28px;
        }

        .step-card {
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-lg);
            padding: 32px 28px;
            box-shadow: var(--shadow-md);
            transition: var(--transition);
            position: relative;
        }

        .step-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-hover);
            border-color: rgba(0, 98, 255, 0.3);
        }

        .step-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
        }

        .step-num {
            font-family: var(--font-display);
            font-size: 32px;
            font-weight: 800;
            color: var(--primary);
            line-height: 1;
        }

        .step-icon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--primary-light);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .step-card h3 {
            font-size: 19px;
            margin-bottom: 14px;
            color: var(--slate-900);
        }

        .step-card ul {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .step-card ul li {
            position: relative;
            padding-left: 22px;
            font-size: 14.5px;
            color: var(--slate-600);
        }

        .step-card ul li::before {
            content: '•';
            position: absolute;
            left: 4px;
            color: var(--primary);
            font-size: 20px;
            line-height: 1;
        }

        /* ================================================================
           HİZMETLERİMİZ (ALL 6 CORE SERVICES)
           ================================================================ */
        .services-wrapper {
            display: flex;
            flex-direction: column;
            gap: 40px;
        }

        .service-showcase-card {
            display: grid;
            grid-template-columns: 1fr 1.3fr;
            align-items: center;
            gap: 60px;
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-xl);
            padding: 50px;
            box-shadow: var(--shadow-md);
            transition: var(--transition);
        }

        .service-showcase-card:hover {
            box-shadow: var(--shadow-hover);
            border-color: rgba(0, 98, 255, 0.3);
        }

        .service-showcase-card.reverse {
            grid-template-columns: 1.3fr 1fr;
        }

        .service-showcase-card.reverse .service-img-box {
            order: 2;
        }

        .service-img-box {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: var(--radius-lg);
            background: radial-gradient(circle, var(--slate-50) 0%, rgba(241, 245, 249, 0.5) 100%);
            padding: 30px;
        }

        .service-img-box img {
            max-width: 380px;
            width: 100%;
            height: auto;
            object-fit: contain;
            filter: drop-shadow(0 15px 30px rgba(0, 98, 255, 0.16));
            transition: var(--transition);
        }

        .service-showcase-card:hover .service-img-box img {
            transform: scale(1.04) translateY(-4px);
        }

        .service-info-box .service-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 700;
            color: var(--primary);
            background: var(--primary-light);
            padding: 6px 14px;
            border-radius: var(--radius-full);
            margin-bottom: 14px;
        }

        .service-info-box h3 {
            font-size: 32px;
            margin-bottom: 18px;
            color: var(--slate-900);
        }

        .service-info-box p {
            font-size: 16px;
            color: var(--slate-600);
            line-height: 1.75;
            margin-bottom: 16px;
        }

        .service-feature-bullets {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin: 24px 0 32px;
        }

        .service-feature-bullets li {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14.5px;
            font-weight: 600;
            color: var(--slate-800);
        }

        .service-feature-bullets li i {
            color: var(--accent-emerald);
            font-size: 15px;
        }

        /* ================================================================
           S.S.S. (FAQ ACCORDION)
           ================================================================ */
        .faq-split {
            display: grid;
            grid-template-columns: 1fr 1.35fr;
            gap: 60px;
            align-items: flex-start;
        }

        .faq-sticky-box {
            position: sticky;
            top: 110px;
            text-align: center;
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-xl);
            padding: 40px 30px;
            box-shadow: var(--shadow-md);
        }

        .faq-illustration {
            max-width: 320px;
            width: 100%;
            height: auto;
            object-fit: contain;
            margin: 0 auto 24px;
            filter: drop-shadow(0 15px 30px rgba(0, 98, 255, 0.16));
        }

        .faq-sticky-box h4 {
            font-size: 22px;
            margin-bottom: 10px;
        }

        .faq-sticky-box p {
            font-size: 15px;
            color: var(--slate-500);
            margin-bottom: 24px;
        }

        .faq-accordion-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .faq-item-card {
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
        }

        .faq-item-card:hover {
            border-color: rgba(0, 98, 255, 0.3);
        }

        .faq-item-card.open {
            border-color: var(--primary);
            box-shadow: 0 8px 24px rgba(0, 98, 255, 0.1);
        }

        .faq-trigger {
            width: 100%;
            padding: 20px 24px;
            background: none;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            text-align: left;
            font-family: var(--font-display);
            font-size: 16.5px;
            font-weight: 700;
            color: var(--slate-900);
            transition: var(--transition);
        }

        .faq-trigger:hover {
            color: var(--primary);
        }

        .faq-item-card.open .faq-trigger {
            color: var(--primary);
        }

        .faq-icon-indicator {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--slate-100);
            color: var(--slate-600);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            flex-shrink: 0;
            transition: var(--transition);
        }

        .faq-item-card.open .faq-icon-indicator {
            background: var(--primary);
            color: var(--white);
            transform: rotate(180deg);
        }

        .faq-body {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.35s ease;
        }

        .faq-item-card.open .faq-body {
            max-height: 500px;
        }

        .faq-body-content {
            padding: 0 24px 22px;
            font-size: 15.5px;
            color: var(--slate-600);
            line-height: 1.75;
            border-top: 1px solid var(--slate-100);
            padding-top: 16px;
        }

        /* ================================================================
           İLETİŞİM BÖLÜMÜ (CONTACT)
           ================================================================ */
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1.25fr;
            gap: 60px;
            align-items: flex-start;
        }

        .contact-info-card {
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-xl);
            padding: 40px;
            box-shadow: var(--shadow-md);
        }

        .contact-illustration {
            max-width: 340px;
            width: 100%;
            height: auto;
            object-fit: contain;
            margin: 0 auto 30px;
            display: block;
            filter: drop-shadow(0 15px 30px rgba(0, 98, 255, 0.16));
        }

        .contact-info-items {
            display: flex;
            flex-direction: column;
            gap: 24px;
            margin-bottom: 32px;
        }

        .contact-detail-row {
            display: flex;
            align-items: flex-start;
            gap: 16px;
        }

        .cdr-icon {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-md);
            background: var(--primary-light);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .cdr-text h4 {
            font-size: 15px;
            font-weight: 700;
            color: var(--slate-900);
            margin-bottom: 2px;
        }

        .cdr-text p, .cdr-text a {
            font-size: 16px;
            color: var(--slate-600);
            line-height: 1.4;
        }

        .cdr-text a:hover {
            color: var(--primary);
        }

        .contact-social-pills {
            display: flex;
            gap: 10px;
            padding-top: 24px;
            border-top: 1px solid var(--slate-200);
        }

        .csp-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            border-radius: var(--radius-full);
            background: var(--slate-100);
            font-size: 14px;
            font-weight: 600;
            color: var(--slate-700);
            transition: var(--transition);
        }

        .csp-btn:hover {
            background: var(--primary);
            color: var(--white);
            transform: translateY(-2px);
        }

        /* Contact Form Card */
        .contact-form-card {
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-xl);
            padding: 44px;
            box-shadow: var(--shadow-lg);
        }

        .contact-form-card h3 {
            font-size: 28px;
            margin-bottom: 8px;
        }

        .contact-form-card > p {
            font-size: 16px;
            color: var(--slate-500);
            margin-bottom: 28px;
        }

        .form-row-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: var(--slate-900);
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            padding: 14px 18px;
            background: var(--slate-50);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-md);
            color: var(--slate-900);
            font-size: 15px;
            outline: none;
            transition: var(--transition);
        }

        .form-control:focus {
            background: var(--white);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--primary-glow);
        }

        textarea.form-control {
            resize: vertical;
            min-height: 120px;
        }

        .form-action-buttons {
            display: flex;
            gap: 14px;
            margin-top: 26px;
            flex-wrap: wrap;
        }

        .form-action-buttons .btn {
            flex: 1;
            min-width: 180px;
        }

        /* Form Feedback Alert Messages */
        .form-alert {
            padding: 16px 20px;
            border-radius: var(--radius-md);
            font-size: 14.5px;
            line-height: 1.6;
            margin-bottom: 22px;
            display: flex;
            align-items: flex-start;
            gap: 14px;
            animation: fadeInAlert 0.3s ease;
        }

        @keyframes fadeInAlert {
            from { opacity: 0; transform: translateY(-6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .form-alert.success {
            background: #ECFDF5;
            border: 1px solid #A7F3D0;
            color: #065F46;
        }

        .form-alert.success i {
            font-size: 22px;
            color: #10B981;
            margin-top: 2px;
        }

        .form-alert.info {
            background: #EFF6FF;
            border: 1px solid #BFDBFE;
            color: #1E40AF;
        }

        .form-alert.info i {
            font-size: 22px;
            color: #3B82F6;
            margin-top: 2px;
        }

        .form-alert.error {
            background: #FEF2F2;
            border: 1px solid #FECACA;
            color: #991B1B;
        }

        .form-alert.error i {
            font-size: 22px;
            color: #EF4444;
            margin-top: 2px;
        }

        .direct-mail-box {
            margin-top: 18px;
            padding-top: 16px;
            border-top: 1px dashed var(--slate-200);
            text-align: center;
        }

        .direct-mail-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--slate-600);
            font-size: 13.5px;
            font-weight: 500;
            text-decoration: none;
            transition: var(--transition);
        }

        .direct-mail-link:hover {
            color: var(--primary);
            text-decoration: underline;
        }

        .direct-mail-link i {
            color: var(--primary);
        }

        .btn.btn-loading {
            pointer-events: none;
            opacity: 0.8;
            cursor: not-allowed;
        }

        /* ================================================================
           FOOTER
           ================================================================ */
        .footer {
            background: var(--dark);
            color: var(--slate-400);
            padding: 80px 0 30px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1.2fr 1.3fr;
            gap: 50px;
            margin-bottom: 60px;
        }

        .footer-brand p {
            font-size: 15px;
            line-height: 1.7;
            margin: 20px 0 24px;
            color: var(--slate-400);
        }

        .footer-logo {
            height: 48px;
            width: auto;
            object-fit: contain;
            filter: brightness(0) invert(1);
        }

        .footer-col h5 {
            font-size: 17px;
            color: var(--white);
            margin-bottom: 22px;
            position: relative;
            padding-bottom: 10px;
        }

        .footer-col h5::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 32px;
            height: 3px;
            background: var(--primary);
            border-radius: 2px;
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .footer-links a {
            font-size: 14.5px;
            color: var(--slate-400);
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .footer-links a:hover {
            color: var(--white);
            transform: translateX(4px);
        }

        .footer-contact-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .footer-contact-list li {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            font-size: 14.5px;
        }

        .footer-contact-list li i {
            color: var(--primary);
            font-size: 16px;
            margin-top: 4px;
        }

        .footer-bottom {
            padding-top: 30px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
            font-size: 14px;
        }

        .footer-legal-links {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .footer-legal-links a {
            color: var(--slate-400);
            text-decoration: underline;
        }

        .footer-legal-links a:hover {
            color: var(--white);
        }

        /* ================================================================
           MODAL DIALOGS (KVKK, COOKIE, TERMS)
           ================================================================ */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(7, 15, 38, 0.75);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 2000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.active {
            display: flex;
            opacity: 1;
        }

        .modal-box {
            background: var(--white);
            border-radius: var(--radius-xl);
            max-width: 680px;
            width: 100%;
            max-height: 85vh;
            overflow-y: auto;
            padding: 40px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
            position: relative;
            transform: translateY(20px);
            transition: transform 0.3s ease;
        }

        .modal-overlay.active .modal-box {
            transform: translateY(0);
        }

        .modal-close-btn {
            position: absolute;
            top: 24px;
            right: 24px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--slate-100);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            color: var(--slate-700);
            transition: var(--transition);
        }

        .modal-close-btn:hover {
            background: var(--slate-200);
            color: var(--slate-900);
        }

        .modal-box h2 {
            font-size: 26px;
            margin-bottom: 20px;
            color: var(--slate-900);
            padding-right: 40px;
        }

        .modal-content-body {
            font-size: 15.5px;
            color: var(--slate-600);
            line-height: 1.8;
        }

        .modal-content-body p {
            margin-bottom: 16px;
        }

        .modal-content-body ul {
            margin: 14px 0 20px 24px;
            list-style: disc;
        }

        .modal-content-body ul li {
            margin-bottom: 8px;
        }

        /* ================================================================
           FLOATING TOOLS (WHATSAPP, SCROLL TOP)
           ================================================================ */
        .floating-whatsapp {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 900;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .wa-tooltip-bubble {
            background: var(--white);
            color: var(--slate-800);
            padding: 8px 16px;
            border-radius: var(--radius-full);
            font-size: 13.5px;
            font-weight: 700;
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--slate-200);
            white-space: nowrap;
            pointer-events: none;
            opacity: 0;
            transform: translateX(10px);
            transition: var(--transition);
        }

        .floating-whatsapp:hover .wa-tooltip-bubble {
            opacity: 1;
            transform: translateX(0);
        }

        .wa-action-btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: #25D366;
            color: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            box-shadow: 0 10px 25px rgba(37, 211, 102, 0.45);
            transition: var(--transition);
            position: relative;
        }

        .wa-action-btn:hover {
            transform: scale(1.1);
            color: var(--white);
        }

        .wa-action-btn::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 2px solid #25D366;
            animation: pulseWa 2s infinite;
        }

        @keyframes pulseWa {
            0% { transform: scale(1); opacity: 0.8; }
            100% { transform: scale(1.4); opacity: 0; }
        }

        .scroll-top-btn {
            position: fixed;
            bottom: 105px;
            right: 36px;
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: var(--white);
            border: 1px solid var(--slate-200);
            color: var(--slate-700);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            box-shadow: var(--shadow-md);
            cursor: pointer;
            z-index: 899;
            opacity: 0;
            visibility: hidden;
            transform: translateY(15px);
            transition: var(--transition);
        }

        .scroll-top-btn.visible {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .scroll-top-btn:hover {
            background: var(--primary);
            color: var(--white);
            border-color: var(--primary);
            transform: translateY(-3px);
        }



        /* ================================================================
           RESPONSIVE BREAKPOINTS & MOBILE IMAGE PROPORTIONS
           ================================================================ */
        @media (max-width: 1100px) {
            .hero {
                padding: 120px 0 70px;
            }
            .hero-grid {
                grid-template-columns: 1fr;
                text-align: center;
                gap: 40px;
            }

            .hero-desc {
                margin: 0 auto 30px;
            }

            .hero-actions {
                justify-content: center;
            }

            .hero-trust-bar {
                justify-content: center;
                gap: 20px;
            }

            .about-split, .story-wrapper, .contact-grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .workflow-banner {
                grid-template-columns: 1fr;
                text-align: center;
                gap: 30px;
            }

            .steps-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .service-showcase-card, .service-showcase-card.reverse {
                grid-template-columns: 1fr;
                gap: 36px;
                padding: 36px 30px;
            }

            .service-showcase-card.reverse .service-img-box {
                order: 0;
            }

            .faq-split {
                grid-template-columns: 1fr;
                gap: 36px;
            }

            .faq-sticky-box {
                position: static;
            }

            .footer-grid {
                grid-template-columns: 1fr 1fr;
                gap: 36px;
            }
        }

        @media (max-width: 768px) {
            html {
                scroll-padding-top: 74px;
            }

            body {
                font-size: 15px;
            }

            .container {
                padding: 0 18px;
            }

            .section {
                padding: 60px 0;
            }

            .section-header {
                margin-bottom: 34px;
            }

            .section-title {
                font-size: clamp(24px, 6.5vw, 32px);
                margin-bottom: 12px;
            }

            .section-desc {
                font-size: 15px;
            }

            /* Navbar Mobile */
            .navbar {
                height: 74px;
            }
            .nav-brand-logo {
                height: 38px;
            }
            .nav-brand-title {
                font-size: 16.5px;
            }
            .nav-brand-sub {
                font-size: 9.5px;
            }
            .nav-menu, .nav-social-icons {
                display: none;
            }
            .nav-hamburger {
                display: flex;
            }
            .nav-actions .btn {
                display: none;
            }
            .mobile-drawer {
                top: 74px;
                height: calc(100vh - 74px);
            }

            /* Hero Mobile & Image Proportions */
            .hero {
                padding: 100px 0 50px;
            }
            .hero-title {
                font-size: clamp(30px, 8.5vw, 42px);
                line-height: 1.2;
                margin: 16px 0 18px;
            }
            .hero-desc {
                font-size: 15.5px;
                line-height: 1.6;
                margin-bottom: 24px;
            }
            .hero-actions {
                flex-direction: column;
                width: 100%;
                gap: 12px;
                margin-bottom: 32px;
            }
            .hero-actions .btn {
                width: 100%;
                justify-content: center;
                padding: 13px 20px;
                font-size: 14.5px;
            }
            .hero-main-img {
                max-width: 320px;
                max-height: 320px;
                width: 100%;
                height: auto;
                object-fit: contain;
                margin: 0 auto;
            }
            .hero-float-card {
                display: none;
            }
            .hero-trust-bar {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 10px;
                padding-top: 20px;
                border-top: 1px solid var(--slate-200);
            }
            .trust-stat {
                padding: 12px 8px;
                background: var(--slate-50);
                border: 1px solid var(--slate-200);
                border-radius: var(--radius-md);
                text-align: center;
            }
            .trust-stat-num {
                font-size: 22px;
            }
            .trust-stat-label {
                font-size: 12px;
            }

            /* Partners Strip Mobile */
            .partners-bar {
                padding: 16px 0;
            }
            .partners-wrapper {
                flex-direction: column;
                text-align: center;
                gap: 12px;
            }
            .partner-pill-group {
                justify-content: center;
                gap: 8px;
            }
            .partner-pill {
                font-size: 12px;
                padding: 6px 12px;
            }

            /* About Mobile & Image Proportions */
            .about-split {
                gap: 28px;
                margin-bottom: 36px;
            }
            .about-main-img {
                max-width: 300px;
                width: 100%;
                height: auto;
                object-fit: contain;
                margin: 0 auto;
            }
            .about-text {
                text-align: center;
            }
            .about-text h3 {
                font-size: 24px;
                margin-bottom: 14px;
            }
            .about-text p {
                font-size: 15px;
                line-height: 1.65;
            }
            .info-cards-grid, .goal-cards-grid {
                grid-template-columns: 1fr;
                gap: 16px;
            }
            .info-box-card, .goal-card {
                padding: 22px 18px;
                border-radius: var(--radius-md);
            }
            .info-box-card h3, .goal-card h3 {
                font-size: 20px;
            }

            /* Story Mobile & Image Proportions */
            .story-wrapper {
                gap: 28px;
            }
            .story-img-card {
                padding: 12px;
                border-radius: var(--radius-lg);
            }
            .story-main-img {
                width: 100%;
                height: auto;
                object-fit: cover;
                border-radius: var(--radius-md);
            }
            .story-badge-bottom {
                width: 100%;
                justify-content: center;
                font-size: 13.5px;
                padding: 10px 16px;
            }
            .story-content {
                text-align: left;
            }
            .story-content h3 {
                font-size: 24px;
                margin-bottom: 14px;
            }
            .story-content p {
                font-size: 14.5px;
                line-height: 1.7;
            }
            .story-traits-grid {
                grid-template-columns: 1fr;
                gap: 10px;
                margin-top: 20px;
            }
            .trait-item {
                padding: 12px 14px;
            }

            /* Workflow Mobile & Image Proportions */
            .workflow-banner {
                padding: 24px 18px;
                border-radius: var(--radius-lg);
                gap: 20px;
                margin-bottom: 36px;
            }
            .workflow-banner-img {
                max-width: 280px;
                width: 100%;
                height: auto;
                object-fit: contain;
                margin: 0 auto;
            }
            .workflow-banner-text h3 {
                font-size: 22px;
                margin-bottom: 10px;
            }
            .workflow-banner-text p {
                font-size: 14.5px;
                line-height: 1.65;
            }
            .steps-grid {
                grid-template-columns: 1fr;
                gap: 16px;
            }
            .step-card {
                padding: 22px 18px;
                border-radius: var(--radius-md);
            }
            .step-num {
                font-size: 26px;
            }
            .step-card h3 {
                font-size: 17.5px;
            }

            /* Services Mobile & Image Proportions */
            .services-wrapper {
                gap: 24px;
            }
            .service-showcase-card {
                padding: 22px 16px;
                border-radius: var(--radius-lg);
                gap: 20px;
            }
            .service-img-box {
                padding: 16px;
                min-height: auto;
                border-radius: var(--radius-md);
            }
            .service-img-box img {
                max-width: 280px;
                max-height: 240px;
                width: 100%;
                height: auto;
                object-fit: contain;
                margin: 0 auto;
            }
            .service-info-box h3 {
                font-size: 23px;
                margin-bottom: 12px;
            }
            .service-info-box p {
                font-size: 14.5px;
                line-height: 1.65;
            }
            .service-feature-bullets {
                grid-template-columns: 1fr;
                gap: 10px;
                margin: 16px 0 22px;
            }
            .service-feature-bullets li {
                font-size: 13.5px;
            }
            .service-info-box .btn {
                width: 100%;
                justify-content: center;
            }

            /* FAQ Mobile & Image Proportions */
            .faq-split {
                gap: 28px;
            }
            .faq-sticky-box {
                padding: 24px 18px;
                border-radius: var(--radius-lg);
            }
            .faq-illustration {
                max-width: 220px;
                width: 100%;
                height: auto;
                object-fit: contain;
                margin: 0 auto 16px;
            }
            .faq-sticky-box h4 {
                font-size: 19px;
            }
            .faq-trigger {
                padding: 16px 18px;
                font-size: 15px;
                gap: 12px;
            }
            .faq-icon-indicator {
                width: 28px;
                height: 28px;
            }
            .faq-body-content {
                padding: 0 18px 16px;
                font-size: 14px;
                line-height: 1.65;
            }

            /* Contact Mobile & Image Proportions */
            .contact-grid {
                gap: 24px;
            }
            .contact-info-card {
                padding: 24px 18px;
                border-radius: var(--radius-lg);
            }
            .contact-illustration {
                max-width: 220px;
                width: 100%;
                height: auto;
                object-fit: contain;
                margin: 0 auto 20px;
            }
            .contact-info-items {
                gap: 18px;
                margin-bottom: 24px;
            }
            .cdr-icon {
                width: 42px;
                height: 42px;
                font-size: 16px;
            }
            .cdr-text h4 {
                font-size: 14px;
            }
            .cdr-text p, .cdr-text a {
                font-size: 14.5px;
            }
            .contact-social-pills {
                flex-direction: column;
                gap: 8px;
            }
            .csp-btn {
                width: 100%;
                justify-content: center;
                padding: 10px 16px;
            }
            .contact-form-card {
                padding: 24px 18px;
                border-radius: var(--radius-lg);
            }
            .contact-form-card h3 {
                font-size: 23px;
            }
            .contact-form-card > p {
                font-size: 14.5px;
                margin-bottom: 20px;
            }
            .form-row-2 {
                grid-template-columns: 1fr;
                gap: 0;
            }
            .form-control {
                font-size: 16px; /* Prevents auto-zoom on iOS Safari */
                padding: 12px 14px;
            }
            .form-action-buttons {
                flex-direction: column;
                gap: 10px;
            }
            .form-action-buttons .btn {
                width: 100%;
                justify-content: center;
            }

            /* Footer Mobile */
            .footer {
                padding: 50px 0 25px;
            }
            .footer-grid {
                grid-template-columns: 1fr;
                gap: 28px;
                margin-bottom: 36px;
            }
            .footer-bottom {
                flex-direction: column;
                text-align: center;
                gap: 14px;
            }
            .footer-legal-links {
                flex-wrap: wrap;
                justify-content: center;
                gap: 12px;
            }

            /* Floating Buttons Mobile */
            .floating-whatsapp {
                bottom: 18px;
                right: 18px;
            }
            .wa-action-btn {
                width: 52px;
                height: 52px;
                font-size: 26px;
            }
            .wa-tooltip-bubble {
                display: none !important;
            }
            .scroll-top-btn {
                bottom: 78px;
                right: 23px;
                width: 42px;
                height: 42px;
                font-size: 14px;
            }

            /* Modals Mobile */
            .modal-box {
                padding: 24px 18px;
                border-radius: var(--radius-lg);
                max-height: 88vh;
            }
            .modal-box h2 {
                font-size: 20px;
                margin-bottom: 14px;
            }
            .modal-content-body {
                font-size: 14px;
                line-height: 1.7;
            }
        }

        @media (max-width: 480px) {
            .container {
                padding: 0 16px;
            }
            .badge-pill {
                font-size: 12px;
                padding: 6px 12px;
            }
            .hero-trust-bar {
                grid-template-columns: repeat(2, 1fr);
                gap: 8px;
            }
            .trust-stat {
                padding: 10px 6px;
            }
            .trust-stat-num {
                font-size: 20px;
            }
            .trust-stat-label {
                font-size: 11px;
            }
        }

        /* ==============================================================
           APPLE & CYBERPUNK ULTRA-LUXE KEYNOTE INTRO STAGE
           ============================================================== */
        #apple-intro {
            position: fixed;
            inset: 0;
            z-index: 999999;
            background: radial-gradient(circle at center, #050d22 0%, #02040a 55%, #010206 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            perspective: 1400px;
            transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), 
                        transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                        visibility 0.85s ease;
            will-change: opacity, transform;
        }

        #apple-intro.intro-dismissed {
            opacity: 0;
            visibility: hidden;
            transform: scale(1.06);
            pointer-events: none;
        }

        /* 1. Nebula & Aurora Parıltıları */
        .ambient-aurora {
            position: absolute;
            width: 800px;
            height: 500px;
            background: radial-gradient(ellipse at center, rgba(0, 194, 255, 0.2) 0%, rgba(0, 98, 255, 0.1) 45%, transparent 70%);
            filter: blur(80px);
            opacity: 0;
            transform: scale(0.6);
            transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
            pointer-events: none;
            z-index: 1;
        }

        .ambient-aurora.ignited {
            opacity: 1;
            transform: scale(1.15);
        }

        /* 2. Geometrik Precision Grid (Hafif ve Derin) */
        .precision-grid {
            position: absolute;
            inset: 0;
            background-image: 
                linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 60px 60px;
            background-position: center center;
            mask-image: radial-gradient(circle at center, black 35%, transparent 80%);
            -webkit-mask-image: radial-gradient(circle at center, black 35%, transparent 80%);
            opacity: 0;
            transition: opacity 0.8s ease;
            z-index: 2;
            pointer-events: none;
        }

        .precision-grid.active {
            opacity: 0.8;
        }

        /* 3. Yatay Kristal Işık Parlaması (Anamorfik Flare) */
        .crystal-beam {
            position: absolute;
            top: calc(50% - 90px);
            left: 50%;
            transform: translate(-50%, -50%) scaleX(0);
            width: 90vw;
            max-width: 1100px;
            height: 2px;
            background: linear-gradient(90deg, 
                transparent 0%, 
                rgba(0, 194, 255, 0.2) 20%, 
                rgba(0, 194, 255, 0.95) 45%, 
                #FFFFFF 50%, 
                rgba(0, 194, 255, 0.95) 55%, 
                rgba(0, 194, 255, 0.2) 80%, 
                transparent 100%);
            box-shadow: 0 0 25px 3px rgba(0, 194, 255, 0.8), 0 0 50px 8px rgba(0, 98, 255, 0.45);
            z-index: 5;
            pointer-events: none;
            transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
            opacity: 0;
        }

        .crystal-beam.active {
            opacity: 0.9;
            transform: translate(-50%, -50%) scaleX(1);
        }

        .crystal-beam.faded {
            opacity: 0.25;
            transition: opacity 0.6s ease;
        }

        /* 4. Kinetik Lazer Hatları (SVG) */
        .laser-streams-svg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 6;
            pointer-events: none;
            transition: opacity 0.5s ease;
        }

        .laser-streams-svg.faded {
            opacity: 0;
        }

        .laser-path {
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: miter;
            transition: stroke-dashoffset 0.85s cubic-bezier(0.16, 1, 0.3, 1);
            filter: drop-shadow(0 0 10px rgba(0, 194, 255, 0.9));
        }

        /* 5. Merkez Sahnesi: Ferah, Net ve Asla Çakışmayan Hiyerarşi */
        .center-stage {
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            max-width: 800px;
            width: 90%;
            padding: 20px;
        }

        /* 3D Cam Kaide */
        .glass-emblem-card {
            position: relative;
            width: 132px;
            height: 132px;
            border-radius: 36px;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
            border: 1px solid rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            box-shadow: 
                0 30px 60px -15px rgba(0, 0, 0, 0.8),
                0 0 0 1px rgba(255, 255, 255, 0.06),
                inset 0 1px 1px 0 rgba(255, 255, 255, 0.4),
                inset 0 -1px 1px 0 rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 28px;
            opacity: 0;
            transform: translateY(20px) scale(0.9) rotateX(12deg);
            transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), 
                        transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                        box-shadow 0.7s ease;
            will-change: transform, opacity;
        }

        .glass-emblem-card.revealed {
            opacity: 1;
            transform: translateY(0) scale(1) rotateX(0deg);
            box-shadow: 
                0 35px 70px -10px rgba(0, 98, 255, 0.45),
                0 0 50px rgba(0, 194, 255, 0.3),
                0 0 0 1px rgba(0, 194, 255, 0.4),
                inset 0 1px 2px 0 rgba(255, 255, 255, 0.6);
        }

        /* Cam Üzerindeki Çevre Lazer Çizgisi */
        .contour-laser-svg {
            position: absolute;
            inset: -10px;
            width: calc(100% + 20px);
            height: calc(100% + 20px);
            transform: rotate(-90deg);
            pointer-events: none;
        }

        .contour-laser-rect {
            stroke-dasharray: 480;
            stroke-dashoffset: 480;
            stroke: url(#cardLaserGrad);
            stroke-width: 2.5;
            stroke-linecap: round;
            fill: none;
            filter: drop-shadow(0 0 8px rgba(0, 194, 255, 0.9));
            transition: stroke-dashoffset 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.08s;
        }

        .glass-emblem-card.revealed .contour-laser-rect {
            stroke-dashoffset: 0;
        }

        /* Resmi Marka Amblemi */
        .official-logo-img {
            width: 96px;
            height: 96px;
            object-fit: contain;
            filter: drop-shadow(0 0 20px rgba(0, 194, 255, 0.9)) drop-shadow(0 8px 24px rgba(0, 98, 255, 0.6));
            opacity: 0;
            transform: scale(0.85);
            transition: opacity 0.4s ease 0.05s, transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) 0.05s;
            position: relative;
            z-index: 2;
            display: block;
        }

        .glass-emblem-card.revealed .official-logo-img {
            opacity: 1;
            transform: scale(1);
        }

        /* Cam Üzerindeki Kayan Işık Süzülmesi */
        

        .glass-emblem-card.revealed 

        

        /* 6. Tipografi: Net, Düzenli ve Asla Çakışmayan Hiyerarşi */
        .title-block {
            display: flex;
            flex-direction: column;
            align-items: center;
            opacity: 0;
            transform: translateY(18px);
            transition: opacity 0.55s ease 0.15s, transform 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
        }

        .title-block.revealed {
            opacity: 1;
            transform: translateY(0);
        }

        /* 1. Satır: MAVİ TİK */
        .brand-headline {
            font-size: clamp(38px, 5.5vw, 54px);
            font-weight: 900;
            letter-spacing: -0.02em;
            line-height: 1.15;
            margin-bottom: 8px;
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .brand-headline .grad-text {
            background: linear-gradient(135deg, #FFFFFF 0%, #E0F2FE 30%, #38BDF8 60%, #00C2FF 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 2px 18px rgba(0, 194, 255, 0.35));
        }

        .brand-headline .ig-verified-badge {
            width: clamp(28px, 4vw, 40px);
            height: clamp(28px, 4vw, 40px);
            flex-shrink: 0;
            display: inline-block;
            vertical-align: middle;
            filter: drop-shadow(0 0 16px rgba(0, 149, 246, 0.85)) drop-shadow(0 2px 6px rgba(0, 0, 0, 0.4));
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
        }

        .brand-headline:hover .ig-verified-badge {
            transform: scale(1.08);
            filter: drop-shadow(0 0 24px rgba(0, 194, 255, 1)) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.5));
        }

        /* 2. Satır: MEDYA AJANSI */
        .brand-subline {
            font-size: clamp(14px, 1.8vw, 17px);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 8px;
            color: #94A3B8;
            margin-bottom: 18px;
        }

        /* 3. Satır: Tek Zarif Lazer Çizgisi */
        .laser-divider {
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, 
                transparent 0%, 
                #0062FF 20%, 
                #00C2FF 50%, 
                #FFFFFF 60%, 
                #00C2FF 70%, 
                #0062FF 80%, 
                transparent 100%);
            box-shadow: 0 0 15px #00C2FF;
            margin-bottom: 20px;
            border-radius: 999px;
            transition: width 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.25s;
        }

        .title-block.revealed .laser-divider {
            width: 240px;
        }

        /* 4. Satır: Tek Seçkin Prestij Rozeti */
        .prestige-pill {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 8px 22px;
            border-radius: 9999px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(14px);
            font-size: 13px;
            font-weight: 600;
            color: #E2E8F0;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        }

        .prestige-pill .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #00C2FF;
            box-shadow: 0 0 10px #00C2FF, 0 0 18px #00C2FF;
            animation: pulseGlow 1.5s infinite alternate;
        }

        @keyframes pulseGlow {
            0% { opacity: 0.5; transform: scale(0.9); }
            100% { opacity: 1; transform: scale(1.3); }
        }

        /* 7. Kontroller */
        .apple-skip-btn {
            position: absolute;
            top: 28px;
            right: 32px;
            z-index: 100;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.14);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            color: #94A3B8;
            font-size: 13px;
            font-weight: 600;
            padding: 9px 20px;
            border-radius: 9999px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 9px;
            transition: all 0.25s ease;
            outline: none;
        }

        .apple-skip-btn:hover {
            color: #FFFFFF;
            background: rgba(0, 194, 255, 0.15);
            border-color: rgba(0, 194, 255, 0.4);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 194, 255, 0.25);
        }

        .apple-skip-btn i {
            font-size: 11px;
            transition: transform 0.2s ease;
        }

        .apple-skip-btn:hover i {
            transform: translateX(3px);
        }

        .apple-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 2px;
            width: 0%;
            background: linear-gradient(90deg, #0040A8, #0062FF, #00C2FF, #FFFFFF);
            box-shadow: 0 0 10px rgba(0, 194, 255, 0.9);
            transition: width 2.4s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 100;
        }

        @media (max-width: 640px) {
            .glass-emblem-card { width: 110px; height: 110px; border-radius: 30px; margin-bottom: 22px; }
            .official-logo-img { width: 78px; height: 78px; }
            .brand-headline { font-size: 32px; }
            .brand-headline .ig-verified-badge { width: 24px; height: 24px; }
            .brand-subline { font-size: 12px; letter-spacing: 5px; margin-bottom: 14px; }
            .laser-divider { margin-bottom: 16px; }
            .title-block.revealed .laser-divider { width: 170px; }
            .prestige-pill { font-size: 12px; padding: 7px 16px; }
            .apple-skip-btn { top: 16px; right: 16px; padding: 7px 14px; font-size: 12px; }
        }
    </style>
</head>
<body>

    <!-- ==============================================================
         APPLE & CYBERPUNK ULTRA-LUXE KEYNOTE INTRO
         ============================================================== -->
    <div id="apple-intro">
        <!-- 1. Derin Lüks Aurora Işığı -->
        <div class="ambient-aurora" id="ambientAurora"></div>

        <!-- 2. Hassas Cyber Izgara Deseni -->
        <div class="precision-grid" id="precisionGrid"></div>

        <!-- 3. Yatay Kristal Işık Çizgisi (Logonun Merkez Arkasında Parlar) -->
        <div class="crystal-beam" id="crystalBeam"></div>

        <!-- 4. Kinetik Lazer Akış Çizgileri (SVG) -->
        <svg class="laser-streams-svg" id="laserStreamsSvg" viewBox="0 0 1200 800" preserveAspectRatio="none">
            <defs>
                <linearGradient id="streamGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#00C2FF" stop-opacity="0" />
                    <stop offset="60%" stop-color="#00C2FF" stop-opacity="0.9" />
                    <stop offset="100%" stop-color="#FFFFFF" stop-opacity="1" />
                </linearGradient>
                <linearGradient id="streamGrad2" x1="100%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#0062FF" stop-opacity="0" />
                    <stop offset="60%" stop-color="#00C2FF" stop-opacity="0.85" />
                    <stop offset="100%" stop-color="#38BDF8" stop-opacity="1" />
                </linearGradient>
                <linearGradient id="cardLaserGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#00C2FF" />
                    <stop offset="50%" stop-color="#FFFFFF" />
                    <stop offset="100%" stop-color="#0062FF" />
                </linearGradient>
            </defs>

            <!-- Sol Kanattan Merkeze Kayan Işık Çizgisi -->
            <!-- Sol Kanattan Merkeze Kayan Keskin M Işını -->
            <path id="laserStreamLeft" class="laser-path"
                  d="M -50,520 L 420,180 L 600,365"
                  stroke="url(#streamGrad1)" stroke-width="3"
                  stroke-linecap="round" stroke-linejoin="miter"
                  stroke-dasharray="1000" stroke-dashoffset="1000" />

            <!-- Sağ Kanattan Merkeze Kayan Keskin M Işını -->
            <path id="laserStreamRight" class="laser-path"
                  d="M 1250,520 L 780,180 L 600,365"
                  stroke="url(#streamGrad2)" stroke-width="3"
                  stroke-linecap="round" stroke-linejoin="miter"
                  stroke-dasharray="1000" stroke-dashoffset="1000" />
        </svg>

        <!-- 5. İntroyu Geç Butonu -->
        <button class="apple-skip-btn" id="appleSkipBtn">
            <span>İntroyu Geç</span>
            <i class="fa-solid fa-arrow-right"></i>
        </button>

        <!-- 6. Mikro İlerleme Çubuğu -->
        <div class="apple-progress" id="appleProgress"></div>

        <!-- 7. Merkez Sahnesi (Tertemiz, Ferah, Asla Çakışmayan Hiyerarşi) -->
        <div class="center-stage">
            <!-- 3D Buzlu Cam Kaide -->
            <div class="glass-emblem-card" id="glassEmblem">
                <svg class="contour-laser-svg" viewBox="0 0 160 160">
                    <rect class="contour-laser-rect" x="12" y="12" width="136" height="136" rx="38" />
                </svg>

                <!-- Resmi Marka Amblemi (Transparan & Kristal Netliğinde) -->
                <!-- Resmi Marka Amblemi (Transparan & Kristal Netliğinde) -->
                <img src="data:image/png;base64," alt="Mavi Tik Medya Amblemi" class="official-logo-img">
            </div>

            <!-- Tipografi & Slogan -->
            <div class="title-block" id="titleBlock">
                <!-- Ana Başlık -->
                <h1 class="brand-headline">
                    <span class="grad-text">MAVİ TİK</span>
                    <svg class="ig-verified-badge" viewBox="0 0 40 40" aria-label="Instagram Doğrulanmış Hesap Rozeti" role="img">
                        <path fill="#0095F6" d="M19.998 3.094 14.638 0l-2.972 5.15H5.432v6.354L0 14.64 3.094 19.998 0 25.358l5.432 3.138v6.354h6.234L14.638 40l5.36-3.094L25.358 40l2.972-5.15h6.234v-6.354L40 25.358l-3.094-5.36L40 14.638l-5.432-3.138V5.15h-6.234L25.358 0l-5.36 3.094Z"/>
                        <path fill="#FFFFFF" d="M16.548 25.184 9.31 17.97l2.19-2.19 5.048 5.04 12.812-12.78 2.19 2.19-15.01 14.954Z"/>
                    </svg>
                </h1>

                <!-- Alt Başlık -->
                <p class="brand-subline">MEDYA AJANSI</p>

                <!-- Lazer Ayırıcı Işık Çizgisi -->
                <div class="laser-divider"></div>

                <!-- Prestij Rozeti -->
                <div class="prestige-pill">
                    <span class="dot"></span>
                    <span>Dijital Dünyada Zirveye Taşıyoruz</span>
                </div>
            </div>
        </div>
    </div>

